# nkinfyx groups Webmail Configuration

APP_NAME="nkinfyx groups Webmail"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nkinfyx_email
DB_USERNAME=root
DB_PASSWORD=

# Security & App Keys
APP_KEY=nkinfyx_secure_secret_key_change_in_production
SESSION_LIFETIME=604800

# SMTP Transport Configuration (Optional for real email delivery)
# If left blank, demo/internal delivery mode is activated with clear notification
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=adminnkinflyx@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=adminnkinflyx@gmail.com
SMTP_FROM_NAME="nkinfyx groups"

# IMAP Inbound Sync Configuration (Sync incoming replies from Gmail/Hostinger into Website Inbox)
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=adminnkinflyx@gmail.com
IMAP_PASSWORD=

# Attachment Settings
MAX_ATTACHMENT_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,gif,zip,txt
STORAGE_PATH=storage/attachments
