<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct web access to sensitive directories and credentials
    RewriteRule ^(\.env|\.git|\.antigravityignore|app|database|docker|storage/attachments) - [F,L]

    # 2. Forward all requests to the public/ folder seamlessly
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent direct access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
